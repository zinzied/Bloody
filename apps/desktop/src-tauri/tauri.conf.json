{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Bloody",
  "version": "10.0.0",
  "identifier": "com.bloody.tokensaver",
  "build": {
    "beforeDevCommand": "npm --prefix ../../.. run build",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm --prefix ../../.. run build && npm --prefix .. run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Bloody Token Saver",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "wix": {
        "language": "en-US",
        "template": null
      }
    }
  },
  "plugins": {
    "notification": {
      "enabled": true
    }
  }
}